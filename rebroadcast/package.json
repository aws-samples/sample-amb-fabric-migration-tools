  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "bin": { "fabric-rebroadcast": "dist/cli/index.js" },
  "main": "dist/cli/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@hyperledger/fabric-protos": "0.3.7",
    "commander": "14.0.3",
    "google-protobuf": "3.21.4"
  },
  "devDependencies": {
    "@types/google-protobuf": "3.15.12",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.9",
    "typescript": "5.9.3"
  }
}
