+func isMigrationCutMarker(env *common.Envelope) bool {
+	payload, err := protoutil.UnmarshalPayload(env.Payload)
+	if err != nil || payload.Header == nil {
+		return false
+	}
+	chdr, err := protoutil.UnmarshalChannelHeader(payload.Header.ChannelHeader)
+	if err != nil {
+		return false
+	}
+	return chdr.Type == int32(common.HeaderType_MESSAGE) && bytes.Equal(payload.Data, migrationCutMarker)
