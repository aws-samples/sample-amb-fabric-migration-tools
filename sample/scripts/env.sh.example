# ── AMB Network Configuration ──
#
# Option A: Auto-resolve from network name (recommended)
#   source sample/scripts/resolve-network.sh --network-name "my-network" \
#     --admin-username admin --admin-password 'MyP@ss'
#
# Option B: Manual — copy this file to env.sh and fill in values:
#   cp sample/scripts/env.sh.example sample/scripts/env.sh
#   vi sample/scripts/env.sh
#   source sample/scripts/env.sh

# Network and member IDs (from the AMB console or auto-resolved)
export NETWORK_ID="n-XXXXXXXXXXXXXXXXXXXXXXXXXX"
export MEMBER_ID="m-XXXXXXXXXXXXXXXXXXXXXXXXXX"
export NODE_ID="nd-XXXXXXXXXXXXXXXXXXXXXXXXXX"

# AWS region where the AMB network lives
export REGION="us-east-1"

# MSP ID — on AMB this is the same as MEMBER_ID
export MSP_ID="$MEMBER_ID"

# Channel name (lowercase alphanumeric + dots/dashes, must start with a letter)
export CHANNEL_NAME="mychannel"

# Admin credentials (set when creating the member — cannot be retrieved via API)
export ADMIN_USERNAME="admin"
export ADMIN_PASSWORD="<YOUR_ADMIN_PASSWORD>"

# ── Paths (set by setup-cloudshell.sh, override if needed) ──
export FABRIC_BIN="$HOME/fabric-tools/bin"
export TLS_CA_CERT="$HOME/managedblockchain-tls-chain.pem"
export MSP_PATH="$HOME/admin-msp"

# Add Fabric tools to PATH
export PATH="$FABRIC_BIN:$PATH"
